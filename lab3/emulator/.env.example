# Після terraform apply скрипт deploy.sh автоматично оновить INGEST_URL.
INGEST_URL=https://YOUR_API_ID.execute-api.eu-central-1.amazonaws.com/measurements
API_KEY=replace-with-a-random-key-at-least-32-characters-long

TEMPERATURE_INTERVAL_MS=100
HUMIDITY_INTERVAL_MS=100
LIGHT_INTERVAL_MS=100

# Camera: 10000-30000 ms between snapshots
CAMERA_INTERVAL_MS=15000
